# Copy to .env for local use, or set these as environment variables on your host.

# ID of the Google Sheet: the long string in its URL between /d/ and /edit
SHEET_ID=

# The service account's JSON key, as one line (or base64 of it). The sheet must be
# shared with the service account's email address as an Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Any long random string (try: openssl rand -hex 32). Sign-in links are signed with
# it, so changing it signs everyone out.
APP_SECRET=

# Any long random string. Opens /admin?key=... where setup and the links live.
ADMIN_KEY=

# Optional
# BASE_URL=https://canvass.example.org   # public address, for generating links behind a proxy
# APP_NAME=Riverside Apartments           # overrides the name saved in the sheet
# TZ=America/Chicago
# PORT=3000

# Optional: lets the app email a personal link to one person, and lets canvassers
# sign in by email from the locked screen. See README.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourorg@gmail.com
# SMTP_PASS=an app password, not the account password
# MAIL_FROM=Your Org <yourorg@gmail.com>
