# Copy to .env for local use, or set these as Variables in Railway.

# ID of the Google Sheet (the long string in its URL)
SHEET_ID=the-long-id-from-the-sheet-url

# The service account's JSON key, pasted as one line. The sheet must be shared
# with the service account's email address as an Editor.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Any long random string. Personal links are derived from it, so changing it
# invalidates every canvasser's link.
APP_SECRET=change-me-to-something-long-and-random

# Any long random string. Needed to open /admin, where the personal links are.
ADMIN_KEY=change-me-too

# Optional. Defaults shown.
TZ=America/Chicago
PORT=3000
